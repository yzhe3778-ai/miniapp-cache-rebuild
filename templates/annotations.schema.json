{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research report annotations",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "identity": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified",
            "partial",
            "missing"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative existing file within evidence root; no traversal, absolute paths or symlinks."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "evidence"
      ],
      "additionalProperties": true
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "dpr": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hostZoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "dpr",
        "hostZoom"
      ],
      "additionalProperties": true
    },
    "visits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "keyNames": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      },
      "uniqueItems": true
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "status",
          "evidence"
        ],
        "properties": {
          "category": {
            "enum": [
              "visual",
              "core_flow",
              "save",
              "reload_restore",
              "export_readback",
              "errors",
              "other"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "passed",
              "manual_verified",
              "failed",
              "partial",
              "missing",
              "unverified"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "description": "Relative existing file within evidence root; no traversal, absolute paths or symlinks."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": true
      }
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "endpoints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
